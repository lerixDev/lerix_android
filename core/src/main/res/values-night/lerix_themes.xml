<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Lerix.Theme.Feedback" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lerix_background</item>
        <item name="android:colorBackground">@color/lerix_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
        <item name="android:textColorSecondary">@color/lerix_text_secondary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Lerix.Theme.Sheet" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Release Control update dialog (centered card). -->
    <style name="Lerix.Theme.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
    </style>
</resources>
