<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen feedback flow. Follows the system light/dark mode (values-night). -->
    <style name="Lerix.Theme.Feedback" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lerix_background</item>
        <item name="android:colorBackground">@color/lerix_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
        <item name="android:textColorSecondary">@color/lerix_text_secondary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- NPS bottom sheet (a plain Dialog; no Material dependency). -->
    <style name="Lerix.Theme.Sheet" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- Release Control full-screen maintenance / required-update screen. -->
    <style name="Lerix.Theme.AppControl" parent="Lerix.Theme.Feedback" />

    <!-- Release Control update dialog (centered card). -->
    <style name="Lerix.Theme.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:textColorPrimary">@color/lerix_text_primary</item>
    </style>
</resources>
